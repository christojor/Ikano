# --------------------------------------------------------------------------- #
#  Application settings                                                       #
# --------------------------------------------------------------------------- #
APP_NAME=Ikano Work Sample
# APP_ENV: local | staging | production
APP_ENV=local
# Enable detailed error pages — NEVER set to true in production
DEBUG=true
# Show service status in Home page header
SHOW_HOME_SERVICE_STATUS=true

# --------------------------------------------------------------------------- #
#  Security                                                                   #
# --------------------------------------------------------------------------- #
# Generate a strong key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED in production — must be at least 32 characters.
SECRET_KEY=dev-only-secret-key-change-in-production-32x

# --------------------------------------------------------------------------- #
#  Database (PostgreSQL)                                                      #
# --------------------------------------------------------------------------- #
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ikano
DB_USER=ikano
DB_PASSWORD=ikano
