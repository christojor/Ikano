    },
    {
      "name": "Onboarding — Error cases",
      "item": [
        {
          "name": "Start with invalid country code",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"country_code\": \"XX\", \"party_type_code\": \"PRIVATE\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/onboarding/start",
              "host": ["{{baseUrl}}"],
              "path": ["api", "onboarding", "start"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET non-existent application",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/onboarding/999999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "onboarding", "999999"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
