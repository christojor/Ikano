# --------------------------------------------------------------------------- #
#  Production environment template                                            #
#  Copy to .env on your server/container and fill in real values.            #
#  NEVER commit a populated .env to source control.                          #
# --------------------------------------------------------------------------- #

APP_NAME=Ikano
APP_ENV=production
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<generate-a-strong-random-value>

DB_HOST=<your-rds-or-cloudsql-host>
DB_PORT=5432
DB_NAME=ikano_prod
DB_USER=ikano_app
DB_PASSWORD=<strong-random-password>
